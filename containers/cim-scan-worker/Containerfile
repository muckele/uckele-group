ARG NODE_BASE_DIGEST=sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
ARG CLAMAV_BASE_DIGEST=sha256:90effb795234e6a93b070310a4bab5a58d93d94b9a077a09ce2229947679782b
FROM node:22-alpine@${NODE_BASE_DIGEST} AS node-runtime
WORKDIR /opt/uckele
COPY package.json package-lock.json ./
RUN set -eu; \
    mkdir -m 0700 /tmp/uckele-npm-config /tmp/uckele-npm-cache; \
    : > /tmp/uckele-npm-config/user.npmrc; \
    : > /tmp/uckele-npm-config/global.npmrc; \
    chmod 0400 /tmp/uckele-npm-config/user.npmrc /tmp/uckele-npm-config/global.npmrc; \
    trap 'status=$?; rm -rf /tmp/uckele-npm-config /tmp/uckele-npm-cache; exit "$status"' EXIT; \
    env -i \
      PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
      HOME=/root \
      CI=true \
      NO_UPDATE_NOTIFIER=1 \
      npm_config_userconfig=/tmp/uckele-npm-config/user.npmrc \
      npm_config_globalconfig=/tmp/uckele-npm-config/global.npmrc \
      npm_config_registry=https://registry.npmjs.org/ \
      npm_config_cache=/tmp/uckele-npm-cache \
      npm_config_foreground_scripts=true \
      npm_config_loglevel=silly \
      npm_config_timing=true \
      npm ci --omit=dev

FROM node-runtime AS cim-scan-synthetic-caller
COPY server/services/cimScanProtocol.js /opt/uckele/server/services/cimScanProtocol.js
COPY server/services/cimScanComposition.js /opt/uckele/server/services/cimScanComposition.js
COPY server/services/cimScanWorker.js /opt/uckele/server/services/cimScanWorker.js
COPY server/services/cimScanWorkerAdmission.js /opt/uckele/server/services/cimScanWorkerAdmission.js
COPY server/services/cimScanWorkerHttp.js /opt/uckele/server/services/cimScanWorkerHttp.js
COPY server/services/cimScanSyntheticCloudCaller.js /opt/uckele/server/services/cimScanSyntheticCloudCaller.js
COPY server/services/cimScanCloudBenchmark.js /opt/uckele/server/services/cimScanCloudBenchmark.js
COPY server/services/flyMachineLeaseController.js /opt/uckele/server/services/flyMachineLeaseController.js
COPY server/services/flyMachineOperabilityAdapters.js /opt/uckele/server/services/flyMachineOperabilityAdapters.js
COPY server/services/flyMachineScanTransport.js /opt/uckele/server/services/flyMachineScanTransport.js
COPY server/services/flyMachinesApiClient.js /opt/uckele/server/services/flyMachinesApiClient.js
COPY server/services/nodePinnedHttpsExchange.js /opt/uckele/server/services/nodePinnedHttpsExchange.js
COPY server/services/onDemandCimScanner.js /opt/uckele/server/services/onDemandCimScanner.js
COPY scripts/run-cim-scan-cloud-synthetic.js /opt/uckele/scripts/run-cim-scan-cloud-synthetic.js
ENTRYPOINT ["node", "scripts/run-cim-scan-cloud-synthetic.js"]

FROM clamav/clamav:1.4.6_base@${CLAMAV_BASE_DIGEST} AS cim-scan-worker-base

# Both official source tags are locked to immutable multi-platform index digests.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /opt/uckele/node_modules /opt/uckele/node_modules
COPY package.json /opt/uckele/package.json
COPY server/services/cimScanProtocol.js /opt/uckele/server/services/cimScanProtocol.js
COPY server/services/cimScanComposition.js /opt/uckele/server/services/cimScanComposition.js
COPY server/services/cimScanWorker.js /opt/uckele/server/services/cimScanWorker.js
COPY server/services/cimScanWorkerAdmission.js /opt/uckele/server/services/cimScanWorkerAdmission.js
COPY server/services/cimScanWorkerEntrypoint.js /opt/uckele/server/services/cimScanWorkerEntrypoint.js
COPY server/services/cimScanWorkerHttp.js /opt/uckele/server/services/cimScanWorkerHttp.js
