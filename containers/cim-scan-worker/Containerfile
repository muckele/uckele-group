ARG NODE_BASE_DIGEST
ARG CLAMAV_BASE_DIGEST
FROM node:22-alpine@${NODE_BASE_DIGEST} AS node-runtime

FROM clamav/clamav:1.4.6_base@${CLAMAV_BASE_DIGEST}

# Both immutable digests are intentionally required build arguments. Until official
# read-only metadata resolves them and a later review records them, an actual build
# must fail rather than silently resolving either mutable source tag. The selected
# Node 22 digest must also be verified to expose the built-in node:sqlite module.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY package.json /opt/uckele/package.json
COPY server/services/cimScanProtocol.js /opt/uckele/server/services/cimScanProtocol.js
COPY server/services/cimScanWorker.js /opt/uckele/server/services/cimScanWorker.js
COPY server/services/clamavUnixSocketScanner.js /opt/uckele/server/services/clamavUnixSocketScanner.js
COPY server/services/filesystemCimReplayStore.js /opt/uckele/server/services/filesystemCimReplayStore.js
COPY server/services/cimScanWorkerEntrypoint.js /opt/uckele/server/services/cimScanWorkerEntrypoint.js
COPY scripts/run-cim-scan-worker.js /opt/uckele/scripts/run-cim-scan-worker.js
COPY containers/cim-scan-worker/clamd.conf /etc/clamav/clamd.conf
COPY containers/cim-scan-worker/entrypoint.sh /usr/local/bin/uckele-cim-scan-entrypoint

WORKDIR /opt/uckele
ENTRYPOINT ["/usr/local/bin/uckele-cim-scan-entrypoint"]
