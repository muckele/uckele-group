{
  "name": "uckele-group-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client & wait",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build && node scripts/prerender-seo.js",
    "backup:create": "node scripts/backup.js create",
    "backup:verify": "node scripts/backup.js verify",
    "backup:restore": "node scripts/backup.js restore",
    "backup:drill": "node --test test/backups.test.js",
    "check": "npm run lint && npm test && npm run test:ui && npm run build",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "test:ui": "vitest run test-ui",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  }
}
